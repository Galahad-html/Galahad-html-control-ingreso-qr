# Servidor MySQL (en la PC de la puerta, usar la IP del servidor en la LAN)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=control_ingreso
DB_USER=app_user
DB_PASSWORD=app_pass_cambiar

# Identificador de esta puerta (1 = Puerta N°1, 2 = Puerta N°2)
PUERTA_ID=1

# Índice de la cámara (0 = la primera webcam)
CAMARA_INDEX=0

# Segundos para ignorar el mismo QR después de leerlo
SEGUNDOS_ANTIRREBOTE=5